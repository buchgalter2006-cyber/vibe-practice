# Образец переменных окружения. Скопируйте в .env и заполните (секреты — только в .env!)
PORT=5000
DATA_SOURCE=mock
APP_DB=data/app.db

# Ф5: сессии и стартовый администратор
# SESSION_SECRET — любой длинный случайный ключ (сессии Flask); сгенерируйте: python -c "import secrets; print(secrets.token_hex(32))"
# ADMIN_PASSWORD — пароль admin при первом старте, если таблица users пуста (смените его в интерфейсе после входа)
SESSION_SECRET=
ADMIN_PASSWORD=

# Источники данных — подключаются в фазе 4 (сейчас пустые)
GOOGLE_SHEET_ID=
GOOGLE_SHEET_NAME=
EXCEL_PATH=
FINTABLO_URL=
FINTABLO_TOKEN=
BITRIX_WEBHOOK_URL=
